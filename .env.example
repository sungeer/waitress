# === 环境（必填，只允许 development / testing / production）===
ENVIRONMENT=development

# === 机密（必填）===
AUTH_KEY=
JWT_SECRET_KEY=
DB_PASSWORD=

# === JWT ===
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# === CORS（必填，逗号分隔）===
ORIGINS=http://127.0.0.1:8080

# === MySQL（连接信息必填，端口可选）===
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_NAME=viper
