# === 环境（必填，只允许 development / testing / production）===
ENVIRONMENT=development

# 日志文件 生产环境配置
LOG_FILE=/srv/logs/waitress.log

# === 机密（必填）===
AUTH_KEY=
JWT_SECRET_KEY=
DB_PASSWORD=

# === JWT ===
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# === CORS（必填，逗号分隔）===
ORIGINS=http://127.0.0.1:8080

# === MySQL（连接信息必填，端口可选）===
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_NAME=viper

# === RQ（REDIS_URL 必填，其余可选）===
REDIS_URL=redis://127.0.0.1:6379/0
# 队列名（queue.py / worker.py 共用）
RQ_QUEUE_NAME=default
# worker 生命周期日志文件
RQ_LIFECYCLE_LOG=/srv/logs/rq_lifecycle.log
